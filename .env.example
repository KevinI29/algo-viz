# algo.viz backend configuration
# Copy to .env at the repo root and fill in a key. Never commit .env.

# LLM provider: anthropic (default) or openai
AI_PROVIDER=anthropic

# Anthropic — required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional; defaults to claude-opus-5-5
ANTHROPIC_MODEL=

# OpenAI — required when AI_PROVIDER=openai
OPENAI_API_KEY=
# Optional; defaults to gpt-4o
OPENAI_MODEL=

# Server
PORT=3001
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173

# Rate limit for POST /api/teach (per IP)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=600000
